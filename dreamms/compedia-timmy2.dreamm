desc[compedia-timmy2]:

name = Timmy the Dream Hunter
icon = compedia-timmy2.png
machine = pc
rootpath = D:\ 
launch = "$(HDDPATH)\Timmy2.exe" EMME /CFG:$(HDDPATH)\itamar2.ini
osenv = windows 98
winres = 640x480x8
CDLABEL=
HDDPATH =

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)
mount[]: vpath = $(HDDPATH); srcpath = $(ifsinstallpath)


script[cd-init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)")
        if (!!file_exists("$$(HDDPATH)\\ITAMAR2.INI")) { file_save("$$(HDDPATH)\\ITAMAR2.INI", "$$(ITAMAR2_CONTENTS)") }
        if (is_windows()) {
            winregistry_import_raw("$$(REGISTRY)");
        }
    ]]]
end

