desc[compedia-timmy2]:

name = Timmy the Dream Hunter
icon = compedia-timmy2.png
machine = pc
rootpath = D:\ 
launch = "$(HDDPATH)\Timmy2.exe" EMME /CFG:$(HDDPATH)\itamar2.ini
osenv = windows 98
winres = 640x480x8
CDLABEL = $(NULL)
HDDPATH =

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)
mount[]: vpath = $(HDDPATH); srcpath = $(ifsinstallpath)

//
// Language options
//
LANGSELECT = false
config[langselect]:
    condition = $(LANGSELECT)
    title = Language Configuration
    option[en]: name = English; LANGCONFIG =eng; priority = 1;
    option[de]: name = German; LANGCONFIG =ger; condition = file_exists("$$(rootpath)\\ITAMAR2G.A")
    option[es]: name = Spanish; LANGCONFIG =spn; condition = file_exists("D:\\SPANISH\\TIMMY2S.A")
    option[de]: name = French; LANGCONFIG =fre; condition = file_exists("$$(rootpath)\\timmy2f.a")

end

script[cd-init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)")
        if (!!file_exists("$$(HDDPATH)\\ITAMAR2.INI")) { file_save("$$(HDDPATH)\\ITAMAR2.INI", "$$(ITAMAR2_CONTENTS)") }
        if (is_windows()) {
            winregistry_import_raw("$$(REGISTRY)");
        }
    ]]]
end

