game[pc-en-961007]:
    name = English 1996-10-07
    anchorfile = TIMMY2.EXE
    imports = cd-pc-en-961007
//    file[]: crc = 98390ccb; size =       480; name = ITAMAR2.INI
//    file[]: crc = e2df8487; size =       860; name = LOST.INI
//    file[]: crc = 811fb39c; size =    387840; name = LOSTDEMO.EXE
//    file[]: crc = 6906e0c5; size =    332288; name = TIM1DEMO.EXE
//    file[]: crc = dc151563; size =       748; name = TIM1DEMO.INI
//    file[]: crc = b5a611bb; size =    416000; name = TIMMY2.EXE
//    file[]: crc = 62d5a801; size =    279808; name = WINDEMO.EXE
//    file[]: crc = 8accddab; size =       558; name = WINDEMO.INI

    ITAMAR2_CONTENTS = [[[$(CRLF)
[GLOBALS]
Languages=ENG
StartMaximized=Yes
SaveDir=C:\FLAGTWR\TIMMY2

[ENG]
16ColorMessage=16color.eng
TxpFile=Timmy2.txp
MaxFont=0
Font0=12  16 12 26  32 255 205 245   0   1
define=nopcx hremme
DataFiles=Timmy2.a  Same.b  Games.c  Music.d Logo.e
LodFile=Timmy2.Lod
WindowTitle=Timmy the Dream Hunter
UseHiresFonts=YES
DiskError=Please insert the correct CD into the CD-ROM drive.
DiskErrorTitle=Timmy the Dream Hunter
[END]

[ACTIVITIES]
STATUS=






]]]



end



end
