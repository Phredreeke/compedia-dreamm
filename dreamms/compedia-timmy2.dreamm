desc[compedia-timmy2]:

name = Timmy the Dream Hunter
icon = compedia-timmy2.png
machine = pc
// rootpath = D:\ 
rootpath = C:\FLAGTWR\TIMMY2
launch = "C:\Flagtwr\Timmy2\Timmy2.exe" EMME /CFG:C:\FLAGTWR\TIMMY2\itamar2.ini
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


script[cd-init]:
    code = [[[$(CRLF)
        drive_set_label("D", "")
        if (!!file_exists("C:\\FLAGTWR\\TIMMY2\\ITAMAR2.INI")) { file_save("C:\\FLAGTWR\\TIMMY2\\ITAMAR2.INI", "$$(ITAMAR2_CONTENTS)") }
        if (is_windows()) {
            winregistry_import_raw("$$(REGISTRY)");
        }
    ]]]
end


config[gamesel]:
    condition = false
    title = Game Select
    option[movie]: name = Filmgurun; launch = "C:\BONNIER\FILMGURU\MOVIE.EXE" EMME /CFG:C:\BONNIER\FILMGURU\movie.ini 
    option[timmy2]: name = Timmy 2 Demo; launch = "C:\BONNIER\FILMGURU\DEMO2S.EXE" EMME /CFG:C:\BONNIER\FILMGURU\demo2s.ini 
    option[lost]: name =  Jakten på de försvunna bokstäverna Demo; launch = "C:\BONNIER\FILMGURU\LOSTDEMO.EXE" EMME /CFG:C:\BONNIER\FILMGURU\lostdemo.ini 
end


