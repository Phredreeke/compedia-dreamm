desc[compedia-julia]:

name = Julia: Back to the Sweet 60's
icon = compedia-julia.png
machine = pc
rootpath = D:\
HDDPATH = C:\JULIA1
launch = "C:\JULIA1\Julia1.exe" /CFG:C:\JULIA1\Julia1.INI
osenv = windows 98
winres = 640x480x32

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\cd
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\cd\eng
mount[]: vpath = Y:\Julia1; srcpath = $(ifsinstallpath)\cd
mount[]: vpath = g:\Swiss\Julia\xfre\zoom; srcpath = $(ifsinstallpath)\cd\eng
mount[]: vpath = g:\Swiss\Julia\xfre; srcpath = $(ifsinstallpath)\cd\eng
mount[]: vpath = $(HDDPATH); srcpath = $(ifsinstallpath)


script[cd-init]:
    code = [[[$(CRLF)
        drive_set_label("D", "Julia1")
        if (!!file_exists("C:\\JULIA1\\Julia1.INI")) { file_save("C:\\JULIA1\\Julia1.INI", "$$(JULIA1_CONTENTS)") }
        if (is_windows()) {
            winregistry_import_raw("$$(REGISTRY)");
        }
    ]]]
end

//
// warnings
//
INCOMPATIBLE = true
warning[incompatible]:
    condition = $(INCOMPATIBLE)
    text = THIS GAME IS UNSUPPORTED
end

game[pc-en-060802]:
