desc[compedia-playroom]:

name = Gordi's Enchanted Playroom
icon = compedia-playroom.png
machine = pc
rootpath = ""
launch = ""
osenv = windows 98
winres = 640x480x8
CDLABEL = $(NULL)
wincrop = true

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD
mount[]: vpath = $(HDDPATH); srcpath = $(ifsinstallpath)


//
// Language options
//
LANGSELECT = false
config[langselect]:
    condition = $(LANGSELECT)
    title = Language Configuration
    option[en]: name = English; LANGCONFIG =eng; priority = 1; condition = file_exists("$$(rootpath)\\WTHINKE.A")
//    option[he]: name = Hebrew; LANGCONFIG =heb; condition = file_exists("$$(rootpath)\\WTHINKH.A")
    option[es]: name = Spanish; LANGCONFIG =span; condition = file_exists("$$(rootpath)\\WTHINKS.A")
end


script[init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)")
        if (!!file_exists("$$(HDDPATH)\\WTHINK.ini")) { file_save("$$(HDDPATH)\\WTHINK.ini", "$$(WTHINK_CONTENTS)") }
    ]]]
end


