    WTHINK_CONTENTS = [[[$(CRLF)
[Globals]
SaveDir=C:\DINAKIDS\PLAYROOM\
Languages=SPAN Eng
StartLanguage=SPANISH
StartDir=D:\Spanish
[ENG]
TxpFile=WThinkE.txp
DatFile=WThinkE.dat
MskFile=Puzl.dat
MazeFile=Maze.dat
FontFile=NewFont
MaxFont=2
;              l-width l-height r-width l-in-row first-l fgcol bgcol shadow1 shadow2  base
Font0=22         23      21       25      32     255   0    0    0        10
Font1=22         23      21       25      32     255   0    0    0        10
Font2=22         23      21       25      32     255   0    0    0        170
DataFiles=WThinke.a WThinks.b WThinks.c WThinks.d
LodFile=WThinke.Lod
Define=
OfsFile=WThinkg.ofs
WindowTitle=Gordi en el cuarto de los juguetes
UseHiresFonts=yes
[END]
[Span]
