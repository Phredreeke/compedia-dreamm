desc[compedia-math1]:

name = Gordi and the Math Invaders
icon = compedia-math1.png
machine = pc
rootpath = D:\
launch = "$(HDDPATH)\Math.exe" /CFG:$(HDDPATH)\Math.ini cdok
osenv = windows 98
winres = 640x480x8
CDLABEL = $(NULL)

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD
mount[]: vpath = $(HDDPATH); srcpath = $(ifsinstallpath)

//
// Language options
//
LANGSELECT = false
config[langselect]:
    condition = $(LANGSELECT)
    title = Language Configuration
    option[en]: name = English; LANGCONFIG =eng; priority = 1;
    option[he]: name = Hebrew; LANGCONFIG =heb; condition = file_exists("$$(rootpath)\\MATH1H.A")
//    option[es]: name = Spanish; LANGCONFIG =spn; condition = file_exists("$$(rootpath)\\TIMMY4S.DAT")
//    option[fr]: name = French; LANGCONFIG =fre; condition = file_exists("$$(rootpath)\\TIMMY4F.DAT")
end

script[cd-init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)")
        if (!!file_exists("$$(HDDPATH)\\Math.ini")) { file_save("$$(HDDPATH)\\Math.ini", "$$(INI_CONTENTS)") }
    ]]]
end

