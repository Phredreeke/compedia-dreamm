desc[compedia-math1]:

name = Gordi and the Math Invaders
icon = compedia-math1.png
machine = pc
rootpath = ""
launch = ""
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD
mount[]: vpath = C:\GSP\math1; srcpath = $(ifsinstallpath)


script[cd-init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)")
        if (!!file_exists("C:\\GSP\\math1\\Math.ini")) { file_save("C:\\GSP\\math1\\Math.ini", "$$(INI_CONTENTS)") }
    ]]]
end


game[pc-en-022201]:
    name = English 2002-01-08
    anchorfile = Math.bmp
    rootpath = D:\
    launch = "C:\GSP\math1\Math.exe" /CFG:C:\GSP\math1\Math.ini /lng:eng
// /CFG:C:\GSP\math1\Math.ini
