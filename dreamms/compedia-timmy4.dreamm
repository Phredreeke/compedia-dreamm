desc[compedia-timmy4]:

name = Timmy's Sea Adventure
icon = compedia-timmy4.png
machine = pc
rootpath = ""
launch = $(HDDPATH)\timmy4.exe EMME /CFG:$(HDDPATH)\Timmy4.ini /lng:$(LANGCONFIG) cdok
osenv = windows 98
winres = 640x480x8
CDLABEL = $(NULL)
TIMMY4_CONTENTS =$(NULL)
HDDPATH =$(NULL)

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD
mount[]: vpath = $(HDDPATH); srcpath = $(ifsinstallpath)


//
// Language options
//
LANGSELECT = false
config[langselect]:
    condition = $(LANGSELECT)
    title = Language Configuration
    option[en]: name = English; LANGCONFIG =eng; priority = 1;
    option[he]: name = Hebrew; LANGCONFIG =heb; condition = file_exists("$$(rootpath)\\TIMMY4H.DAT")
    option[es]: name = Spanish; LANGCONFIG =spn; condition = file_exists("$$(rootpath)\\TIMMY4S.DAT")
    option[fr]: name = French; LANGCONFIG =fre; condition = file_exists("$$(rootpath)\\TIMMY4F.DAT")
    option[br]: name = Portuguese; LANGCONFIG =bra; condition = file_exists("$$(rootpath)\\TIMMY4B.DAT")
    option[br]: name = Czech; LANGCONFIG =cze; condition = file_exists("$$(rootpath)\\TIMMY4C.DAT")
end


script[init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)")
        if (!!file_exists("$$(HDDPATH)\\Timmy4.ini")) { file_save("$$(HDDPATH)\\Timmy4.ini", "$$(TIMMY4_CONTENTS)") }
    ]]]
end



