desc[compedia-timmy4]:

name = Timmy Sea Adventure
icon = compedia-timmy4.png
machine = pc
rootpath = ""
launch = ""
osenv = windows 98
winres = 640x480x8
TIMMY4_CONTENTS =
TIM4INT_CONTENTS =
HDDPATH =

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD
mount[]: vpath = $(HDDPATH); srcpath = $(ifsinstallpath)


//
// Language options
//
LANGSELECT = false
config[langselect]:
    condition = $(LANGSELECT)
    title = Language Configuration
    option[en]: name = English; LANGCONFIG =eng; priority = 1;
    option[se]: name = Hebrew; LANGCONFIG =heb; 
end


script[init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)")
        if (!!file_exists("$$(HDDPATH)\\Timmy4.ini")) { file_save("$$(HDDPATH)\\Timmy4.ini", "$$(TIMMY4_CONTENTS)") }
        if (!!file_exists("$$(HDDPATH)\\TIM4INT.ini")) { file_save("$$(HDDPATH)\\TIM4INT.ini", "$$(TIM4INT_CONTENTS)") }
    ]]]
end



game[pc-multi-971203]:
    name = Hebrew/English 1997-12-03
    anchorfile = TIMMY4.BMP
    HDDPATH = C:\Compedia\Timmy4
    launch = C:\Compedia\Timmy4\timmy4.exe /CFG:C:\Compedia\Timmy4\Timmy4.ini /lng:$(LANGCONFIG)
    rootpath = D:\HEBREW 
    LANGSELECT = true
    CDLABEL=TIMMY4
