desc[compedia-timmy3]:

name = Timmy Birthday Party
icon = compedia-timmy3.png
machine = pc
rootpath = ""
launch = ""
osenv = windows 98
winres = 640x480x8
FUNPACK_CONTENTS =
HDDPATH =

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD
mount[]: vpath = $(HDDPATH); srcpath = $(ifsinstallpath)


//
// Language options
//
LANGSELECT = false
config[langselect]:
    condition = $(LANGSELECT)
    title = Language Configuration
    option[en]: name = English; LANGCONFIG =eng; priority = 1;
//    option[se]: name = Hebrew; LANGCONFIG =heb; condition = file_exists("$$(rootpath)\\FUNPACKH.A")
    option[es]: name = Spanish; LANGCONFIG =span; condition = file_exists("$$(rootpath)\\FUNPACKS.A")
end


script[init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)")
        if (!!file_exists("$$(HDDPATH)\\FUNPACK.ini")) { file_save("$$(HDDPATH)\\FUNPACK.ini", "$$(FUNPACK_CONTENTS)") }
    ]]]
end


game[pc-es-991212]:
    name = Spanish 1999-12-22
    anchorfile = Fondol.bmp
    launch = C:\DINAKIDS\Timmy3\FUNPACK.EXE EMME /CFG:C:\DINAKIDS\Timmy3\funpack.ini /lng:$(LANGCONFIG)
