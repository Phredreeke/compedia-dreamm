desc[compedia-movie]:

name = Gordi's Magical Movie Adventure
icon = compedia-movie.png
machine = pc
rootpath = ""
launch = ""
osenv = windows 98
winres = 640x480x8
CDLABEL = $(NULL)

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
// mount[]: vpath = C:\BONNIER\FILMGURU\; srcpath = $(ifsinstallpath)
// mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)\CD
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)\CD

script[cd-init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)")
        if (!!file_exists("$$(rootpath)\\MOVIE.INI")) { file_save("$$(rootpath)\\MOVIE.INI", "$$(MOVIE_CONTENTS)") }
    ]]]
end


