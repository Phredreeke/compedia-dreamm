desc[compedia-supermind]:

name = Supermind
icon = compedia-supermind.png
machine = pc
rootpath = D:\eng
launch = "$(HDDPATH)\superm.exe" /CFG:$(HDDPATH)\superm.ini
osenv = windows 98
winres = 640x480x16
CDLABEL = $(NULL)


//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD
mount[]: vpath = $(HDDPATH); srcpath = $(ifsinstallpath)


script[init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)")
        if (!!file_exists("$$(HDDPATH)\\superm.ini")) { file_save("$$(HDDPATH)\\superm.ini", "`h:5B 50 41 54 48 5D 0D 0A 43 44 50 41 54 48 3D 44 3A 0D 0A 48 44 50 41 54 48 3D 43 3A 5C 50 52 4F 47 52 41 7E 31 5C 43 6F 6D 70 65 64 69 61 5C 53 75 70 65 72 6D 0D 0A 43 44 24 5C 4C 4E 47 24 0D 0A 43 44 24 5C 4C 4E 47 24 5C 67 61 6D 65 73 0D 0A 43 44 24 5C 4C 4E 47 24 5C 74 69 72 67 75 6C 0D 0A 43 44 24 5C 4C 4E 47 24 5C 6D 69 76 68 61 6E 0D 0A 43 44 24 5C 4C 4E 47 24 5C 6C 69 6D 75 64 0D 0A 43 44 24 5C 6D 75 73 69 63 0D 0A 5B 45 4E 44 5D 0D 0A 0D 0A 5B 47 4C 4F 42 41 4C 53 5D 0D 0A 4C 61 6E 67 75 61 67 65 3D 45 4E 47 0D 0A 52 75 6E 64 69 72 3D 43 44 24 5C 6C 6F 67 6F 0D 0A 53 74 61 72 74 44 69 72 3D 44 3A 0D 0A 53 61 76 65 44 69 72 3D 43 3A 5C 50 52 4F 47 52 41 7E 31 5C 43 6F 6D 70 65 64 69 61 5C 53 75 70 65 72 6D 0D 0A 5B 45 4E 44 5D 0D 0A 0D 0A 5B 45 4E 47 5D 0D 0A 41 72 72 46 6F 72 77 61 72 64 3D 72 69 67 68 74 0D 0A 43 72 65 64 69 74 73 3D 31 0D 0A 52 65 73 75 6C 74 73 58 59 3D 5B 5B 33 36 36 2C 31 30 33 5D 2C 5B 32 39 38 2C 31 33 38 5D 2C 5B 33 36 34 2C 31 36 39 5D 2C 5B 33 36 39 2C 32 30 33 5D 2C 5B 34 30 35 2C 32 33 36 5D 2C 5B 32 31 35 2C 32 37 31 5D 5D 0D 0A 5B 45 4E 44 5D 0D 0A 0D 0A 5B 45 4E 44 46 49 4C 45 5D 0D 0A") }
    ]]]
end


