desc[compedia-timmy1]:

name = Timmy and the Magic Pictures
icon = compedia-timmy1.png
machine = pc
rootpath = D:\
launch = "$(HDDPATH)\Timmy1.exe" EMME /CFG:$(HDDPATH)\TIMMY1.ini
osenv = windows 98
CDLABEL = $(NULL)
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\cd
mount[]: vpath = $(HDDPATH); srcpath = $(ifsinstallpath)

//
// Language options
//
LANGSELECT = false
config[langselect]:
    condition = $(LANGSELECT)
    title = Language Configuration
    option[en]: name = English; LANGCONFIG =eng; priority = 1;
    option[he]: name = Hebrew; LANGCONFIG =heb; condition = file_exists("$$(rootpath)\\TIMMY1H.A")
    option[fr]: name = French; LANGCONFIG =fre; condition = file_exists("$$(rootpath)\\Timmy1f.a")
    option[es]: name = Spanish; LANGCONFIG =spn; condition = file_exists("$$(rootpath)\\Timmy1s.a")
    option[ar]: name = Spanish; LANGCONFIG =arg; condition = file_exists("$$(rootpath)\\Timmy1a.a")
end


script[cd-init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)")
        if (!!file_exists("$$(HDDPATH)\\TIMMY1.ini")) { file_save("$$(HDDPATH)\\TIMMY1.ini", "$$(INI_CONTENTS)") }
    ]]]
end


