desc[compedia-timmy1]:

name = Timmy and the Magic Pictures
icon = compedia-timmy1.png
machine = pc
// rootpath = D:\ 
rootpath = C:\FLAGTWR\TIMMY1
launch = "C:\Flagtwr\Timmy1\Timmy1.exe" EMME /CFG:C:\FLAGTWR\TIMMY1\TIMMY1.ini
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


script[cd-init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)")
        if (!!file_exists("$$(INIPATH)")) { file_save("$$(INIPATH)", "$$(INI_CONTENTS)") }
    ]]]
end


