//    file[]: crc = 246f329a; size =     54272; name = Setup.exe
//    file[]: crc = ab346e98; size =       118; name = Setup.ini
//    file[]: crc = f7189e71; size =    138295; name = setup.inx

    LOST_CONTENTS = [[[$(CRLF)
[GLOBALS]
Languages=ENG
SaveDir=C:\Compedia\Lost
CardPitch=998
StartDir=D:

[ENG]
16ColorMessage=16Color.Eng
TextFile=nreadE.txt
TxpFile=nreadE.txp
DatFile=nreadE.dat
PicFile=nreadE.pic
TrsFile=nreadE.trs
WrdFile=nreadE.wrd
FontFile=efonts
MaxFont=2
;              l-width l-height r-high l-in-row first-l fgcol bgcol shadow1 shadow2  base
Font0=12         16      16     26        32     211   205    189      0      0
Font1=17         22      22     18        97     212   205     0       0      99
Font2=12         16      16     26        58     211   205     0       0     149
DataFiles=nreadE.a nreadE.b nreadE.c nreadE.d nreadE.e
LodFile=nreadE.Lod
PlayPreLogo=NO
OfsFile=nreadE.ofs
WindowTitle=In Search of the Lost Words
SaveName=NEW GAME
SaveFileName=NreadE.Gam
UseHiresFonts=
TransLang=
HelpsLang=
Useintdemo=no
[END]
[PATH]
HDPath=C:\Compedia\Lost
CDPath=D:




]]]




end



end
