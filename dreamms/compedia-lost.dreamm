desc[compedia-lost]:

name = In Search of the Lost Words
icon = compedia-lost.png
machine = pc
rootpath = D:\ 
// rootpath = C:\Compedia\Lost
launch = "$(HDDPATH)\lost.exe" /CFG:$(HDDPATH)\lost.ini 
osenv = windows 98
winres = 640x480x8
wincrop = true
HDDPATH =
CDLABEL=

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)
mount[]: vpath = $(HDDPATH); srcpath = $(ifsinstallpath)

script[cd-init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)LOSTWORDS")
        if (!!file_exists("$$(HDDPATH)\\LOST.INI")) { file_save("$$(HDDPATH)\\LOST.INI", "$$(LOST_CONTENTS)") }
    ]]]
end


