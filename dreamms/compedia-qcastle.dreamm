    WNEWADD_CONTENTS = [[[$(CRLF)
[GLOBALS]
Languages=ENG   
MyPalette=Yes
SaveDir=C:\Learning\Quantum
Musiclevel=3
Soundlevel=10
StartDir=D:

[ENG]
