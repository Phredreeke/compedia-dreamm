desc[compedia-qcastle]:

name = Quantum Castle
icon = compedia-qcastle.png
machine = pc
rootpath = D:\
launch = "$(HDDPATH)\WNEWADD.EXE" /CFG:$(HDDPATH)\WNEWADD.ini
osenv = windows 98
winres = 640x480x8
TIMMY4_CONTENTS =
TIM4INT_CONTENTS =
HDDPATH =
wincrop = true

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD
mount[]: vpath = $(HDDPATH); srcpath = $(ifsinstallpath)



script[init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)")
        if (!!file_exists("$$(HDDPATH)\\WNEWADD.ini")) { file_save("$$(HDDPATH)\\WNEWADD.ini", "$$(WNEWADD_CONTENTS)") }
    ]]]
end



game[pc-en-011213]:
    name = English 2001-12-13
    anchorfile = ADD.A
    HDDPATH = C:\Learning\Quantum
    CDLABEL=QUANTUM
    file[]: crc = 2f0e22a3; size =    327168; name = WNEWADD.EXE
